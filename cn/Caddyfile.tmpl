# tomomai cn — Caddyfile template
#
# Rendered by ./deploy.sh into /etc/caddy/Caddyfile on the remote host.
# Placeholders (substituted at install time):
#   {{PROXY_DOMAIN}}  e.g. cn.tomomai.lol     — what Caddy listens on
#   {{UPSTREAM}}      e.g. tomomai.lol        — what we reverse-proxy to
#   {{ACME_EMAIL}}    Let's Encrypt registration email
#   {{STATIC_TTL}}    edge-cache TTL for /_next/static/* (e.g. 720h)
#   {{IMAGE_TTL}}     edge-cache TTL for /_next/image    (e.g. 24h)

{
    email {{ACME_EMAIL}}
    servers {
        protocols h1 h2 h3
    }
    # Souin (caddy-cache-handler) — built into Caddy via xcaddy at install.
    cache {
        ttl 60s
        default_cache_control public
    }
}

{{PROXY_DOMAIN}} {
    encode zstd gzip

    # Reject Host-fuzzing / misdirected SNI. Defence-in-depth.
    @badhost not host {{PROXY_DOMAIN}}
    respond @badhost 421

    # --- Edge cache: Next.js immutable build assets -------------------------
    # /_next/static/* paths are content-hashed by the Next build, so a 30d
    # TTL is safe — a new deployment changes the hash, which changes the
    # cache key. Saves CN2 bandwidth on cold-cache + repeat clients.
    @nextStatic path /_next/static/*
    handle @nextStatic {
        cache {
            ttl {{STATIC_TTL}}
            stale 24h
        }
        reverse_proxy https://{{UPSTREAM}} {
            header_up Host {{UPSTREAM}}
            transport http {
                tls
                tls_server_name {{UPSTREAM}}
                versions 2 1.1
                keepalive 60s
                keepalive_idle_conns 32
            }
        }
        header Cache-Control "public, max-age=31536000, immutable"
        header X-Cn-Cache {http.cache_status}
    }

    # --- Edge cache: Next.js image optimizer --------------------------------
    # Keyed by full URL (incl. query string), so different sizes/formats
    # don't collide. Shorter TTL since the underlying source image can
    # change (CDN URLs rotate).
    @nextImg path /_next/image*
    handle @nextImg {
        cache {
            ttl {{IMAGE_TTL}}
            stale 6h
        }
        reverse_proxy https://{{UPSTREAM}} {
            header_up Host {{UPSTREAM}}
            transport http {
                tls
                tls_server_name {{UPSTREAM}}
                versions 2 1.1
            }
        }
        header X-Cn-Cache {http.cache_status}
    }

    # --- Everything else: pass-through --------------------------------------
    # Host is *not* overridden — Caddy's default sends Host={{UPSTREAM}} to
    # the upstream. We do this (instead of preserving Host={{PROXY_DOMAIN}})
    # so the upstream chain works whether or not it goes through Cloudflare:
    #
    #   - Vercel-direct (e.g. *.vercel.app): Vercel routes by .vercel.app
    #     hostname to the project; all aliases share the same code/env.
    #   - CF-fronted (cloudflared dev tunnels, orange-cloud apex): CF sees a
    #     Host it manages (the upstream's), not {{PROXY_DOMAIN}} (which is
    #     gray-cloud — sending that triggers CF Error 1000 "DNS points to
    #     prohibited IP", since CF can't resolve a gray-cloud hostname back
    #     to itself).
    #
    # The app still knows the original hostname via X-Forwarded-Host
    # (auto-set by reverse_proxy from the inbound Host header). Read by
    # Better Auth (advanced.trustedProxyHeaders: true in src/lib/auth.ts)
    # and by resolveBaseUrlFromHeaders() in src/lib/base-url.ts.
    reverse_proxy https://{{UPSTREAM}} {
        # X-Forwarded-{For,Proto,Host} are auto-set; only X-Real-IP isn't.
        # src/lib/security/rate-limiter.ts checks it as a fallback after
        # cf-connecting-ip and x-forwarded-for.
        header_up X-Real-IP           {remote_host}

        transport http {
            tls
            # SNI matches Host (= {{UPSTREAM}} by Caddy default). Vercel's
            # edge / cloudflared / etc. picks the right cert based on SNI.
            tls_server_name {{UPSTREAM}}
            versions 2 1.1
            keepalive 30s
            keepalive_idle_conns 32
        }
        # Don't buffer RSC streams or Server Actions. -1 = flush ASAP.
        flush_interval -1
    }

    # Subdomain-scoped HSTS. Apex sets its own; we don't pin includeSubDomains
    # here in case other subdomains aren't HTTPS yet.
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    log {
        output file /var/log/caddy/{{PROXY_DOMAIN}}.log {
            roll_size 50mb
            roll_keep 7
        }
        format json
    }
}
