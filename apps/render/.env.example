# Postgres (same DB as apps/main)
POSTGRES_URL=postgres://user:pass@host:5432/db

# Shared HMAC secret used by apps/main to mint render tokens and by this service
# to verify them. Must match RENDER_TOKEN_SECRET in apps/main.
RENDER_TOKEN_SECRET=change-me

# Static image/font assets (the /res tree). This app owns its own copy under
# ./public/res, so the default (process.cwd()/public) just works in dev — only
# set this to override. Docker sets it to /app/public.
# PUBLIC_DIR=./public

# R2 cover origins (same as apps/main) — used to build cover URLs.
NEXT_PUBLIC_R2_URL=https://your-r2-host
NEXT_PUBLIC_R2_URL_CN=https://your-r2-host-cn

# Enabled regions (comma-separated), mirrors apps/main.
NEXT_PUBLIC_ENABLED_REGIONS=intl,jp,cn

# CORS allow-origin for /img (the web download button fetches it cross-origin).
# Default "*" is fine (token-gated, no cookies); lock to the site origin if desired.
# CORS_ORIGIN=https://your-site

PORT=8080
LOG_LEVEL=info
