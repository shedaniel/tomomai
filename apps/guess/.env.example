# Required: HMAC secret used to deterministically derive the daily chart + step
# plan. Generate with: openssl rand -hex 32. Keep this secret — leaking it lets
# players precompute future days.
GUESS_DAILY_SECRET=

# Optional: which game variant this deployment serves. Defaults to "guess"
# (image-based guessing at guesser.tomomai.lol). Set to "heardle" for the
# audio-only Heardle-style variant at heardle.tomomai.lol — the daily song
# pool is restricted to charts with an Apple Music preview, and the only hint
# type is a progressively longer audio clip: L0..L6 = 1s, 2s, 4s, 7s, 11s,
# 16s, 30s (full preview). Pair with GUESS_HINT_COUNT=7 below.
# GUESSER_MODE=guess

# Optional: base URL for the tomomai songs catalogue API.
# Defaults to https://www.tomomai.lol when unset.
# TOMOMAI_API_URL=http://localhost:3000

# Optional: number of hints before the reveal (default 6, min 2).
# GUESS_HINT_COUNT=6

# Optional: absolute base URL used to resolve OpenGraph / Twitter image URLs
# in metadata. Defaults to https://guesser.tomomai.lol.
# NEXT_PUBLIC_SITE_URL=https://guesser.tomomai.lol

# Optional: pin the daily picker to a fixed key for local development. Any
# non-empty value works — the dateKey becomes "debug-<value>" so different
# values give different stable songs.
# DEBUG_KEY=1

# Optional: Redis connection string. When set, /api/search is rate-limited
# per IP via @tomomai/security. Unset → limiter is a no-op (safe for local dev).
# REDIS_URL=redis://localhost:6379

# Optional: slow every Framer Motion transition by this factor for visual
# debugging of card / label / panel animations. Inlined into the client
# bundle at build, so changes require a dev-server restart.
# NEXT_PUBLIC_DEBUG_ANIMATION=8
