# Local OAuth app setup:
# - Main site: http://localhost:3000/settings/developer
# - App type: confidential OAuth app
# - Redirect URI: http://localhost:3002/api/auth/callback
# - Scopes:
#   user:metadata:read
#   user:settings:read
#   snapshot:all:metadata:read
#   snapshot:all:songs:read
#   snapshot:all:events:read
#   snapshot:all:icon:read
#   recent:read
#   recent:detailed:read
#   stats:read
#   album:read
#   album:images:read
#
# Production redirect URI:
# - https://takeout.tomomai.lol/api/auth/callback

NEXT_PUBLIC_SITE_URL=http://localhost:3002
TOMOMAI_API_BASE=http://localhost:3000
TOMOMAI_OAUTH_CLIENT_ID=
TOMOMAI_OAUTH_CLIENT_SECRET=
TAKEOUT_SESSION_SECRET=replace-with-at-least-32-random-bytes
