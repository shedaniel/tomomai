# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*

# monorepo package build outputs
packages/*/dist
packages/*/tsconfig.tsbuildinfo

# Generated at prebuild/predev from node_modules/altcha
apps/main/public/altcha/argon2id.js

# next.js (any app)
.next/
out/

# production
build/

# testing
coverage/

# misc
.DS_Store
*.pem
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# main-site resources
apps/main/imgs/**/*.**
!apps/main/imgs/**/*.afphoto
apps/main/public/res/preloaded/*.gz

# workspace-level imgs (legacy location)
imgs/**/*.**
!imgs/**/*.afphoto
