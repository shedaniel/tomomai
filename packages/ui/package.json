{
  "name": "@tomomai/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./src/styles/globals.css",
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./animation-constants": {
      "import": "./dist/animation-constants.js",
      "types": "./dist/animation-constants.d.ts"
    },
    "./themes": {
      "import": "./dist/themes.js",
      "types": "./dist/themes.d.ts"
    },
    "./select-friendly": {
      "import": "./dist/select-friendly.js",
      "types": "./dist/select-friendly.d.ts"
    }
