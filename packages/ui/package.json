    "@radix-ui/react-tooltip": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "embla-carousel-react": "*",
    "lucide-react": "*",
    "motion": "*",
    "radix-ui": "*",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": "*",
    "recharts": "*",
    "sonner": "*",
    "tailwind-merge": "*",
    "vaul": "*",
    "web-haptics": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
